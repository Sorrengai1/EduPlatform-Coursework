@using System.Linq
@model IEnumerable<EduPlatform.Models.Course>

@{
    ViewData["Title"] = "Каталог курсів";
}

<div class="container py-4">

    <!-- Заголовок каталогу -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-2" style="color: #40101F;">
                Каталог курсів
            </h1>
            <p class="text-muted mb-0">
                Обирайте цікаві курси, навчайтеся та вдосконалюйте свої навички.
            </p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Порожній каталог -->
        <div class="text-center py-5 bg-white rounded shadow-sm border"
             style="border-color: #F2E8EA !important;">

            <i class="bi bi-journal-x"
               style="font-size: 4rem; color: #E8E0D5;"></i>

            <h4 class="mt-3 fw-bold" style="color: #6D1F32;">
                Курсів поки немає
            </h4>

            <p class="text-muted">
                Незабаром тут з'являться нові навчальні курси.
            </p>
        </div>
    }
    else
    {
        <!-- Сітка курсів -->
        <div class="row g-4">

            @foreach (var course in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 position-relative border-0 shadow-sm course-card catalog-course-card">

                        <!-- Статус публічності -->
                        <span class="badge @(course.IsPublic ? "bg-success" : "bg-secondary") position-absolute top-0 start-0 m-3"
                              style="z-index: 10;">
                            @(course.IsPublic ? "Публічний" : "Приватний")
                        </span>

                        <!-- Обкладинка курсу -->
                        <div class="catalog-course-cover">

                            @if (!string.IsNullOrWhiteSpace(course.ImagePath))
                            {
                                <img src="@course.ImagePath"
                                     alt="Обкладинка курсу @course.Title"
                                     class="catalog-course-image"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="catalog-course-placeholder">
                                    <i class="bi bi-code-square"></i>
                                </div>
                            }

                        </div>

                        <!-- Інформація про курс -->
                        <div class="card-body d-flex flex-column p-4">

                            <!-- Назва -->
                            <h5 class="card-title fw-bold catalog-course-title">
                                @course.Title
                            </h5>

                            <!-- Скорочений опис -->
                            <p class="card-text text-muted small catalog-course-description">
                                @course.Description
                            </p>

                            <!-- Нижня частина картки -->
                            <div class="mt-auto">

                                <div class="catalog-course-meta">
                                    <span class="text-muted small">
                                        <i class="bi bi-journal-text me-1"></i>
                                        Модулів: @(course.Modules?.Count ?? 0)
                                    </span>

                                    @if (course.DurationHours > 0)
                                    {
                                        <span class="text-muted small">
                                            <i class="bi bi-clock me-1"></i>
                                            @course.DurationHours год
                                        </span>
                                    }
                                </div>

                                <!-- Перегляд курсу -->
                                <a asp-controller="Course"
                                   asp-action="Details"
                                   asp-route-id="@course.Id"
                                   class="btn btn-primary w-100 catalog-course-button">
                                    Переглянути курс
                                    <i class="bi bi-arrow-right ms-2"></i>
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
