@model EduPlatform.Models.Question

@{
    ViewData["Title"] = "Редагувати питання";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    var answers = Model.Answers.ToList();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background-color: #6D1F32;">
                    <h4 class="mb-0"><i class="bi bi-pencil me-2"></i> Редагувати питання: @ViewBag.ModuleTitle</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EditQuestion" method="post" id="questionForm">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Текст питання:</label>
                            <input type="text" name="text" value="@Model.Text" class="form-control" required />
                        </div>

                        <h5 class="fw-bold mt-4 mb-3">Варіанти відповідей (оберіть правильні):</h5>
                        <div id="optionsContainer">
                            @for (int i = 0; i < answers.Count; i++)
                            {
                                <div class="input-group mb-2">
                                    <div class="input-group-text">
                                        <input type="checkbox" name="correctIndexes" value="@i" @(answers[i].IsCorrect ? "checked" : "") />
                                    </div>
                                    <input type="text" name="options" class="form-control" value="@answers[i].Text" required />
                                </div>
                            }
                        </div>

                        <button type="button" class="btn btn-outline-secondary btn-sm mb-3" onclick="addOption()">+ Додати варіант</button>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="ManageQuestions" asp-route-moduleId="@ViewBag.ModuleId" class="btn btn-outline-secondary">Скасувати</a>
                            <button type="submit" class="btn btn-success">Зберегти зміни</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let optionCount = @answers.Count;
        function addOption() {
            const container = document.getElementById('optionsContainer');
            const newDiv = document.createElement('div');
            newDiv.className = 'input-group mb-2';
            const index = optionCount; 
            newDiv.innerHTML = `
                <div class="input-group-text">
                    <input type="checkbox" name="correctIndexes" value="${index}" />
                </div>
                <input type="text" name="options" class="form-control" placeholder="Варіант ${index + 1}" required />
                <button type="button" class="btn btn-danger" onclick="this.parentElement.remove()">Видалити</button>
            `;
            container.appendChild(newDiv);
            optionCount++;
        }
    </script>
}