
@model IEnumerable<EduPlatform.Models.LibraryItem>

@{
    ViewData["Title"] = "Авторські матеріали";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold" style="color: #40101F;">
        Авторські матеріали
    </h2>

    <a asp-controller="Library"
       asp-action="Create"
       class="btn btn-success shadow-sm">
        <i class="bi bi-plus-lg me-1"></i>
        Додати матеріал до бібліотеки
    </a>
</div>

<p class="text-muted mb-4">
    Тут відображаються навчальні матеріали, які ви
    опублікували в бібліотеці EduPlatform.
    Ви можете переглядати власні публікації
    та керувати ними.
</p>

@* Повідомлення після додавання або видалення матеріалу *@
@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4"
         role="alert"
         style="background-color: #EAF3EC;
                border: 1px solid #C7DCCB;
                border-left: 4px solid #3D5C4B;
                color: #2F503E;
                border-radius: 10px;">

        <i class="bi bi-check-circle-fill me-2"></i>
        @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Закрити">
        </button>
    </div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4"
         role="alert"
         style="border-radius: 10px;">

        <i class="bi bi-exclamation-circle-fill me-2"></i>
        @errorMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Закрити">
        </button>
    </div>
}

<h4 class="fw-bold mb-4" style="color: #6D1F32;">
    <i class="bi bi-journal-text me-2"></i>
    Мої публікації (@Model.Count())
</h4>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-4">
        <i class="bi bi-journal-x fs-1 d-block mb-2"
           style="color: #6D1F32;"></i>

        Ви ще не додали жодного матеріалу до бібліотеки.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var material in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column">

                        <span class="badge mb-2 align-self-start"
                              style="background-color: #F7F2F3;
                                     color: #6D1F32;">
                            @material.Category
                        </span>

                        <h5 class="card-title fw-bold"
                            style="color: #40101F;">
                            @material.Title
                        </h5>

                        <p class="card-text text-muted small flex-grow-1">
                            @(string.IsNullOrWhiteSpace(material.Description)
                                ? "Опис відсутній"
                                : material.Description)
                        </p>

                        <p class="text-muted small">
                            <i class="bi bi-calendar3 me-1"></i>
                            @material.CreatedAt.ToString("dd.MM.yyyy")
                        </p>

                        @if (!string.IsNullOrWhiteSpace(material.Url))
                        {
                            <a href="@material.Url"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-primary mb-2">
                                <i class="bi bi-link-45deg me-1"></i>
                                Відкрити матеріал
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(material.FilePath))
                        {
                            <a href="@material.FilePath"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-primary mb-2">
                                <i class="bi bi-download me-1"></i>
                                Завантажити файл
                            </a>
                        }

                        <form asp-controller="Library"
                              asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Видалити цей матеріал із бібліотеки?');"
                              class="mt-2">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@material.Id" />

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger w-100">
                                <i class="bi bi-trash me-1"></i>
                                Видалити
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
}
