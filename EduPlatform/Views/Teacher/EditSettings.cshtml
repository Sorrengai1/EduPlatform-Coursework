@model EduPlatform.Models.CourseModule

@{
    ViewData["Title"] = "Налаштування модуля";
}

<h1>Налаштування: @Model.Title</h1>
<p class="text-muted">Курс: @Model.Course?.Title</p>
<hr />

<form asp-action="EditSettings" method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Максимальна кількість спроб:</label>
        <input type="number" name="maxAttempts" value="@Model.MaxAttempts" class="form-control" min="1" max="20" required />
        <small class="text-muted">Вкажіть, скільки разів студент може пройти цей тест.</small>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="showCorrectAnswers" value="true" id="showAnswers" @(Model.Course?.ShowCorrectAnswers == true ? "checked" : "") />
        <label class="form-check-label" for="showAnswers">
            Показувати правильні відповіді студентам після тесту
        </label>
    </div>

    <button type="submit" class="btn btn-success">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>