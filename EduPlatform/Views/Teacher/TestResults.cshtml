@model IEnumerable<EduPlatform.Models.Attempt>

@{
    ViewData["Title"] = "Результати тесту";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    var module = ViewBag.Module as EduPlatform.Models.CourseModule;
}

<style>
    .teacher-results-card {
        background: #FFFFFF;
        border: 1px solid #E6EAE4 !important;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(64, 16, 31, 0.06) !important;
    }

    .teacher-results-table {
        width: 100%;
        margin-bottom: 0;
        vertical-align: middle;
        --bs-table-bg: #FFFFFF;
        --bs-table-hover-bg: #F0F6F0;
    }

    .teacher-results-table thead th {
        background-color: #D7E0D3 !important;
        color: #2F503E !important;
        font-weight: 700;
        font-size: 14px;
        padding: 18px 22px;
        border-bottom: 2px solid #B9CDB9 !important;
        white-space: nowrap;
    }

    .teacher-results-table tbody td {
        padding: 18px 22px;
        border-bottom: 1px solid #EDF0EB;
        color: #40101F;
        background-color: #FFFFFF;
        transition: background-color 0.2s ease;
    }

    .teacher-results-table tbody tr:hover td {
        background-color: #F0F6F0 !important;
    }

    .teacher-results-table tbody tr:last-child td {
        border-bottom: none;
    }

    .teacher-results-table .student-name {
        font-weight: 700;
        color: #40101F;
    }

    .teacher-results-table .result-date {
        color: #68746C;
        font-size: 14px;
        white-space: nowrap;
    }

    .teacher-results-table .score-badge {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 13px;
    }

    .teacher-results-table .score-passed {
        background-color: #E5F3E9;
        color: #217343;
    }

    .teacher-results-table .score-failed {
        background-color: #FBE9EB;
        color: #C7354A;
    }

    .teacher-results-table .result-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
    }

    .teacher-results-table .status-passed {
        color: #21804A;
    }

    .teacher-results-table .status-failed {
        color: #D83C50;
    }

    .teacher-results-table .empty-results {
        padding: 42px 20px;
        text-align: center;
        color: #7A817B;
    }

    .teacher-results-back {
        border: 1px solid #6D1F32;
        color: #6D1F32;
        border-radius: 8px;
        padding: 9px 15px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .teacher-results-back:hover {
        background-color: #6D1F32;
        border-color: #6D1F32;
        color: #FFFFFF;
    }

    @@media (max-width: 768px) {
        .teacher-results-table thead th,
        .teacher-results-table tbody td {
            padding: 13px 15px;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-2" style="color: #40101F;">
            Результати: @module?.Title
        </h2>
        <p class="text-muted mb-0">
            Курс: @module?.Course?.Title
        </p>
    </div>

    <a asp-action="MyTests" class="teacher-results-back">
        <i class="bi bi-arrow-left me-1"></i>
        Назад до тестів
    </a>
</div>

<div class="card teacher-results-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover teacher-results-table">
                <thead>
                    <tr>
                        <th>Студент</th>
                        <th>Бал</th>
                        <th>Дата</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var result in Model)
                        {
                            <tr>
                                <td>
                                    <span class="student-name">
                                        @string.Join(" ", new[]
                                        {
                                            result.Student?.LastName,
                                            result.Student?.Name,
                                            result.Student?.MiddleName
                                        }.Where(x => !string.IsNullOrWhiteSpace(x)))
                                    </span>
                                </td>

                                <td>
                                    <span class="score-badge @(result.Score >= 60 ? "score-passed" : "score-failed")">
                                        @result.Score%
                                    </span>
                                </td>

                                <td>
                                    <span class="result-date">
                                        @result.StartedAt.ToString("dd.MM.yyyy HH:mm")
                                    </span>
                                </td>

                                <td>
                                    @if (result.Score >= 60)
                                    {
                                        <span class="result-status status-passed">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Складено
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="result-status status-failed">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Не складено
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="empty-results">
                                <i class="bi bi-clipboard-data d-block fs-3 mb-2"></i>
                                Результатів для цього тесту ще немає.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
