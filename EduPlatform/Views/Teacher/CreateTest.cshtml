@{
    ViewData["Title"] = "Створити тест";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background-color: #6D1F32;">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Створити новий тест</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateTest" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Оберіть курс:</label>
                            <select name="courseId" class="form-select" required>
                                <option value="">-- Виберіть курс --</option>
                                @foreach (var course in ViewBag.Courses)
                                {
                                    <option value="@course.Id">@course.Title</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Назва тесту (модуля):</label>
                            <input type="text" name="title" class="form-control" placeholder="Наприклад: Основи JavaScript" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Максимальна кількість спроб:</label>
                            <input type="number" name="maxAttempts" value="3" min="1" max="10" class="form-control" required />
                        </div>

                        <!-- ГАЛОЧКА ДЛЯ ПОКАЗУ ВІДПОВІДЕЙ -->
                        <div class="form-check mb-4">
                            <input type="checkbox" name="showCorrectAnswers" value="true" class="form-check-input" id="showAnswers" />
                            <label class="form-check-label fw-bold" for="showAnswers">
                                Показувати правильні відповіді студентам після тесту
                            </label>
                            <small class="text-muted d-block">Якщо вимкнено, студент побачить лише бал.</small>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="MyTests" class="btn btn-outline-secondary">Скасувати</a>
                            <button type="submit" class="btn btn-success">Створити тест</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>