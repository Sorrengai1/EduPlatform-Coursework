
@model EduPlatform.Models.Student

@{
    ViewData["Title"] = "Мій профіль";

    if (Model.Role == "Teacher")
    {
        Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_StudentLayout.cshtml";
    }
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white"
                     style="background-color: #6D1F32;">
                    <h4 class="mb-0">
                        <i class="bi bi-person-circle me-2"></i>
                        Мій профіль
                    </h4>
                </div>

                <div class="card-body p-4">

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success">
                            @ViewBag.Message
                        </div>
                    }

                    <form asp-action="Profile"
                          method="post"
                          enctype="multipart/form-data"
                          asp-antiforgery="true">

                        <div class="text-center mb-4">

                            <div class="position-relative d-inline-block">

                                <img id="avatarPreview"
                                     src="@(string.IsNullOrWhiteSpace(Model.AvatarPath) ? "" : Model.AvatarPath)"
                                     alt="Попередній перегляд аватарки"
                                     class="rounded-circle"
                                     style="width: 140px;
                                            height: 140px;
                                            object-fit: cover;
                                            border: 4px solid #F7F2F3;
                                            display: @(string.IsNullOrWhiteSpace(Model.AvatarPath) ? "none" : "block");" />

                                <div id="avatarPlaceholder"
                                     class="rounded-circle align-items-center justify-content-center"
                                     style="width: 140px;
                                            height: 140px;
                                            background-color: #F7F2F3;
                                            color: #6D1F32;
                                            font-size: 3.5rem;
                                            border: 4px solid #E8E0D5;
                                            display: @(string.IsNullOrWhiteSpace(Model.AvatarPath) ? "flex" : "none");">
                                    <i class="bi bi-person"></i>
                                </div>

                                <label for="avatarInput"
                                       class="position-absolute bottom-0 end-0 bg-white rounded-circle p-2 shadow-sm"
                                       style="cursor: pointer;"
                                       title="Змінити фото">
                                    <i class="bi bi-camera text-dark"></i>
                                </label>
                            </div>

                            <div class="mt-3">
                                <label for="avatarInput"
                                       class="btn btn-sm"
                                       style="background-color: #3D5C4B;
                                              color: white;
                                              border-radius: 8px;">
                                    <i class="bi bi-image me-1"></i>
                                    Обрати фото
                                </label>
                            </div>

                            <input type="file"
                                   id="avatarInput"
                                   name="avatarFile"
                                   class="visually-hidden"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   aria-describedby="avatarStatus avatarError" />

                            <div id="avatarStatus"
                                 class="small mt-2"
                                 style="color: #3D5C4B;"
                                 role="status"
                                 aria-live="polite">
                                Фото можна змінити перед збереженням.
                            </div>

                            <div id="avatarError"
                                 class="text-danger small mt-2"
                                 role="alert"
                                 style="display: none;">
                            </div>

                            <div class="text-muted small mt-1">
                                JPG, PNG або WEBP, до 5 МБ
                            </div>
                        </div>

                        <!-- Ім'я, Прізвище, По батькові -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold"
                                       for="profileName">Ім'я:</label>
                                <input id="profileName"
                                       type="text"
                                       name="name"
                                       value="@Model.Name"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold"
                                       for="profileLastName">Прізвище:</label>
                                <input id="profileLastName"
                                       type="text"
                                       name="lastName"
                                       value="@Model.LastName"
                                       class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold"
                                       for="profileMiddleName">По батькові:</label>
                                <input id="profileMiddleName"
                                       type="text"
                                       name="middleName"
                                       value="@Model.MiddleName"
                                       class="form-control" />
                            </div>
                        </div>

                        <!-- Email та роль -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold"
                                       for="profileEmail">Email:</label>
                                <input id="profileEmail"
                                       type="email"
                                       name="email"
                                       value="@Model.Email"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Роль:</label>
                                <input type="text"
                                       value="@(Model.Role == "Teacher" ? "Викладач" : "Студент")"
                                       class="form-control"
                                       disabled />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 gap-2">
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                На головну
                            </a>

                            <button type="submit"
                                    class="btn text-white"
                                    style="background-color: #6D1F32;">
                                <i class="bi bi-check-circle me-1"></i>
                                Зберегти зміни
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("avatarInput");
        const preview = document.getElementById("avatarPreview");
        const placeholder = document.getElementById("avatarPlaceholder");
        const status = document.getElementById("avatarStatus");
        const error = document.getElementById("avatarError");

        const maxSize = 5 * 1024 * 1024;
        const allowedTypes = [
            "image/jpeg",
            "image/png",
            "image/webp"
        ];

        input.addEventListener("change", function () {
            const file = input.files[0];

            error.style.display = "none";
            error.textContent = "";

            if (!file) {
                return;
            }

            if (!allowedTypes.includes(file.type)) {
                error.textContent =
                    "Оберіть зображення у форматі JPG, PNG або WEBP.";
                error.style.display = "block";
                input.value = "";
                return;
            }

            if (file.size > maxSize) {
                error.textContent =
                    "Розмір зображення не повинен перевищувати 5 МБ.";
                error.style.display = "block";
                input.value = "";
                return;
            }

            const reader = new FileReader();

            reader.onload = function (event) {
                preview.src = event.target.result;
                preview.style.display = "block";
                placeholder.style.display = "none";

                status.textContent =
                    "Нове фото обрано. Натисніть «Зберегти зміни», щоб зберегти його.";
            };

            reader.onerror = function () {
                error.textContent =
                    "Не вдалося прочитати зображення. Оберіть інший файл.";
                error.style.display = "block";
                input.value = "";
            };

            reader.readAsDataURL(file);
        });
    });
</script>
