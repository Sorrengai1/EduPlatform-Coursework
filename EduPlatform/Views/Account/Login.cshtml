@{
    ViewData["Title"] = "Вхід";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background-color: #6D1F32;">
                    <h4 class="mb-0"><i class="bi bi-box-arrow-in-right me-2"></i> Вхід</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" role="alert">
                                Перевірте виділені поля та виправте помилки.
                                Електронну адресу збережено у формі.
                            </div>
                        }

                        <div class="mb-3">
                            <label for="email" class="form-label fw-bold">Email: <span class="text-danger">*</span></label>
                            <input id="email" type="email" name="email" value="@ViewBag.Email"
                                   class="form-control @(ViewData.ModelState.ContainsKey("email") && ViewData.ModelState["email"]!.Errors.Count > 0 ? "is-invalid" : "")"
                                   maxlength="254" autocomplete="username" required />
                            @Html.ValidationMessage("email", null, new { @class = "invalid-feedback d-block" })
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label fw-bold">Пароль: <span class="text-danger">*</span></label>
                            <input id="password" type="password" name="password"
                                   class="form-control @(ViewData.ModelState.ContainsKey("password") && ViewData.ModelState["password"]!.Errors.Count > 0 ? "is-invalid" : "")"
                                   autocomplete="current-password" required />
                            @Html.ValidationMessage("password", null, new { @class = "invalid-feedback d-block" })
                        </div>

                        <div class="d-flex justify-content-between align-items-center gap-2 mt-4">
                            <a asp-action="Register" class="btn btn-outline-secondary">Немає акаунта? Зареєструватися</a>
                            <button type="submit" class="btn btn-primary">Увійти</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
