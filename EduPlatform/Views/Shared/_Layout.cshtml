
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduPlatform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.webp" alt="Logo" style="height: 40px; width: 40px; margin-right: 10px; border-radius: 50%;" />
                    <span>EduPlatform</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Головна</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Course" asp-action="Index">Каталог курсів</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Library" asp-action="Index">Бібліотека</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="About">Про платформу</a></li>

                        @if (Context.Session.GetString("UserRole") == "Teacher")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Teacher" asp-action="Index">Кабінет викладача</a></li>
                        }
                        @if (Context.Session.GetString("UserRole") == "Student")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Student" asp-action="Dashboard">Кабінет студента</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (Context.Session.GetString("UserRole") != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">

                                    @if (!string.IsNullOrEmpty(ViewBag.UserAvatarPath as string))
                                    {
                                        <img src="@ViewBag.UserAvatarPath" alt="Avatar" class="rounded-circle me-2" style="width: 35px; height: 35px; object-fit: cover; border: 2px solid #6D1F32;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-2"
                                             style="width: 35px; height: 35px; background-color: #6D1F32; color: white; font-weight: bold; text-transform: uppercase;">
                                            @{
                                                string fullName = ViewBag.UserFullName as string;
                                                string firstLetter = !string.IsNullOrEmpty(fullName) ? fullName.Substring(0, 1) : "?";
                                            }
                                            @firstLetter
                                        </div>
                                    }

                                    <span class="d-none d-md-inline fw-bold">@(ViewBag.UserFullName ?? "Користувач")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i> Профіль</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Вийти</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark fw-bold" asp-controller="Account" asp-action="Login">Увійти</a></li>
                            <li class="nav-item ms-2"><a class="btn text-white fw-bold" style="background-color: #6D1F32;" asp-controller="Account" asp-action="Register">Реєстрація</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container text-center">
            &copy; 2026 - EduPlatform - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Повідомлення про помилку мережевого з'єднання -->
    <div id="networkError"
         class="alert alert-danger shadow position-fixed bottom-0 end-0 m-4"
         role="alert"
         aria-live="assertive"
         style="display: none; z-index: 9999; max-width: 380px;">

        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-wifi-off fs-4"></i>
            <div>
                <strong>Помилка з'єднання</strong>
                <p class="mb-2">
                    Не вдалося встановити з'єднання із сервером.
                    Перевірте мережу та повторіть спробу.
                </p>
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        onclick="document.getElementById('networkError').style.display='none'">
                    Закрити
                </button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (() => {
            const errorBox = document.getElementById('networkError');

            function showNetworkError() {
                errorBox.style.display = 'block';
            }

            function hideNetworkError() {
                errorBox.style.display = 'none';
            }

            // Відстеження втрати та відновлення з'єднання
            window.addEventListener('offline', showNetworkError);
            window.addEventListener('online', hideNetworkError);

            // Перевірка стану мережі при відкритті сторінки
            if (!navigator.onLine) {
                showNetworkError();
            }

            // Обробка мережевих помилок AJAX-запитів
            if (window.jQuery) {
                $(document).ajaxError(function (_event, xhr) {
                    if (xhr.status === 0) {
                        showNetworkError();
                    }
                });
            }
        })();
    </script>
</body>
</html>
