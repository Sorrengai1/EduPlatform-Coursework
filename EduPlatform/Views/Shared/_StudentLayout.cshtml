<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduPlatform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <div class="app-container">
        <!-- Бокове меню -->
        <aside class="sidebar-dark">
            <a asp-controller="Home" asp-action="Index" class="sidebar-header">
                <img src="~/images/logo.webp" alt="Logo" style="height: 35px; width: 35px; margin-right: 10px; border-radius: 50%;" />
                 EduPlatform
            </a>
            <nav class="sidebar-nav">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Dashboard" ? "active" : "")" asp-controller="Student" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill"></i> Кабінет
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "MyProgress" ? "active" : "")" asp-controller="Student" asp-action="MyProgress">
                            <i class="bi bi-graph-up"></i> Прогрес 
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "MyCourses" ? "active" : "")" asp-controller="Student" asp-action="MyCourses">
                            <i class="bi bi-book"></i> Курси
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Library" asp-action="Index">
                            <i class="bi bi-journal-bookmark"></i> Бібліотека
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout" style="color: #F87171 !important;">
                    <i class="bi bi-box-arrow-right"></i> Вийти
                </a>
            </div>
        </aside>

        <!-- Головна частина -->
        <main class="main-content">
            <header class="top-navbar">
                <div class="d-flex align-items-center">
                    <h5 class="mb-0 fw-bold" style="color: #40101F;">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-dark" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                            
                            @if (!string.IsNullOrEmpty(ViewBag.UserAvatarPath as string))
                            {
                                <img src="@ViewBag.UserAvatarPath" alt="Avatar" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover; border: 2px solid #6D1F32;" />
                            }
                            else
                            {
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-2" 
                                     style="width: 40px; height: 40px; background-color: #6D1F32; color: white; font-weight: bold; font-size: 1.1rem; text-transform: uppercase;">
                                    @{
                                        string fullName = ViewBag.UserFullName as string;
                                        string firstLetter = !string.IsNullOrEmpty(fullName) ? fullName.Substring(0, 1) : "?";
                                    }
                                    @firstLetter
                                </div>
                            }

                            <span class="d-none d-md-inline fw-bold">
                                @(ViewBag.UserFullName ?? "Студент")
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i> Профіль</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Вийти</a></li>
                        </ul>
                    </div>
                </div>
            </header>
            <div class="content-area">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>