@model IEnumerable<EduPlatform.Models.Attempt>
@{
    ViewData["Title"] = "Прогрес";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var attempts = Model.ToList();
    var totalTests = attempts.Count;
    var avgScore = totalTests > 0 ? Math.Round(attempts.Average(a => a.Score), 1) : 0;
    var passedTests = attempts.Count(a => a.Score >= 60);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold" style="color: #40101F;">Прогрес</h2>
</div>

<p class="text-muted mb-4">
    Тут відображається історія ваших тестувань: бали, статус та дати. 
    Використовуйте цю інформацію, щоб відстежувати свій прогрес.
</p>

<!-- Картки статистики -->
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-clipboard-check fs-1" style="color: #6D1F32;"></i>
                <h6 class="text-muted text-uppercase mt-2">Всього тестів</h6>
                <h2 class="display-6 fw-bold" style="color: #6D1F32;">@totalTests</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-trophy fs-1" style="color: #6D1F32;"></i>
                <h6 class="text-muted text-uppercase mt-2">Успішно складено</h6>
                <h2 class="display-6 fw-bold" style="color: #3D5C4B;">@passedTests</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-bar-chart-line fs-1" style="color: #6D1F32;"></i>
                <h6 class="text-muted text-uppercase mt-2">Середній бал</h6>
                <h2 class="display-6 fw-bold" style="color: #6D1F32;">@avgScore%</h2>
            </div>
        </div>
    </div>
</div>

@if (!attempts.Any())
{
    <div class="text-center py-5 bg-white rounded shadow-sm border">
        <i class="bi bi-rocket-takeoff" style="font-size: 4rem; color: #E8E0D5;"></i>
        <h4 class="mt-3 fw-bold" style="color: #6D1F32;">Ви ще не проходили тестів</h4>
        <p class="text-muted">Ваш шлях у світ IT тільки починається. Оберіть курс та пройдіть перший тест.</p>
        <a asp-controller="Course" asp-action="Index" class="btn btn-primary">Перейти до каталогу</a>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead style="background-color: #F7F2F3;">
                        <tr>
                            <th class="py-3 px-4 border-0">Курс</th>
                            <th class="py-3 px-4 border-0">Модуль</th>
                            <th class="py-3 px-4 border-0">Бал</th>
                            <th class="py-3 px-4 border-0">Статус</th>
                            <th class="py-3 px-4 border-0">Дата</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attempt in attempts)
                        {
                            <tr>
                                <td class="py-3 px-4">@attempt.Module?.Course?.Title</td>
                                <td class="py-3 px-4">@attempt.Module?.Title</td>
                                <td class="py-3 px-4 fw-bold">@attempt.Score%</td>
                                <td class="py-3 px-4">
                                    @if (attempt.Score >= 60)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Складено</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">Не складено</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-muted">@attempt.StartedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}