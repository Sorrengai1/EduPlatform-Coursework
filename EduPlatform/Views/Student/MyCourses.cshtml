
@model IEnumerable<EduPlatform.Models.Course>

@{
    ViewData["Title"] = "Мої курси";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var courses = (Model ?? Enumerable.Empty<EduPlatform.Models.Course>()).ToList();
}

<style>
    /* Картки курсів */
    .my-course-card {
        background-color: #FDFBF7;
        border: 1px solid #EEE7E5 !important;
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .my-course-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(64, 16, 31, 0.10) !important;
    }

    /* Декоративна верхня смужка */
    .my-course-accent {
        height: 5px;
        background: linear-gradient(90deg, #6D1F32, #3D5C4B);
    }

    /* Статус курсу */
    .my-course-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .my-course-badge.public {
        background-color: #E3ECE5;
        color: #3D5C4B;
    }

    .my-course-badge.private {
        background-color: #F2E8EA;
        color: #6D1F32;
    }

    /* Назва курсу — максимум 2 рядки */
    .my-course-title {
        color: #40101F;
        font-size: 1.1rem;
        line-height: 1.4;
        min-height: 3.08rem;

        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        overflow: hidden;
    }

    /* Опис курсу — максимум 3 рядки */
    .my-course-description {
        color: #746D70;
        font-size: 0.9rem;
        line-height: 1.6;
        min-height: 4.32rem;

        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        overflow: hidden;
        overflow-wrap: anywhere;
    }

    /* Нижня частина картки */
    .my-course-footer {
        border-top: 1px solid #EEE7E5;
        padding-top: 16px;
        margin-top: auto;
    }

    .my-course-info {
        color: #746D70;
        font-size: 0.85rem;
    }

    /* Кнопка перегляду */
    .my-course-button {
        border: 1px solid #6D1F32;
        color: #6D1F32;
        background-color: transparent;
        border-radius: 9px;
        font-weight: 600;
        padding: 9px 14px;
        transition: all 0.2s ease;
    }

    .my-course-button:hover {
        background-color: #6D1F32;
        border-color: #6D1F32;
        color: #FFFFFF;
    }

    .my-course-button:focus-visible {
        outline: 2px solid #3D5C4B;
        outline-offset: 3px;
    }
</style>

<!-- Заголовок -->
<div class="d-flex flex-wrap justify-content-between
            align-items-center gap-3 mb-4">

    <h2 class="fw-bold mb-0" style="color: #40101F;">
        Мої курси
    </h2>

    <a asp-controller="Course"
       asp-action="Index"
       class="btn btn-outline-primary">
        <i class="bi bi-plus-circle me-2"></i>
        Каталог курсів
    </a>
</div>

<p class="text-muted mb-4">
    Тут відображаються курси, до яких ви приєдналися
    або на які вас записав викладач.
</p>

@if (!courses.Any())
{
    <div class="text-center py-5 px-3 bg-white rounded-4 shadow-sm border">

        <i class="bi bi-journal-x d-block mb-3"
           style="font-size: 3rem; color: #6D1F32;"></i>

        <h4 class="fw-bold" style="color: #40101F;">
            У вас поки немає курсів
        </h4>

        <p class="text-muted">
            Перегляньте каталог і приєднайтеся до курсу,
            щоб розпочати навчання.
        </p>

        <a asp-controller="Course"
           asp-action="Index"
           class="btn btn-primary">
            Переглянути каталог
        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var course in courses)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <div class="card my-course-card h-100 shadow-sm">

                    <!-- Верхня смужка -->
                    <div class="my-course-accent"></div>

                    <div class="card-body d-flex flex-column p-4">

                        <!-- Статус -->
                        <div class="mb-3">
                            <span class="my-course-badge @(course.IsPublic ? "public" : "private")">

                                <i class="bi @(course.IsPublic ? "bi-globe2" : "bi-lock-fill") me-1"></i>

                                @(course.IsPublic ? "Публічний" : "Приватний")

                            </span>
                        </div>

                        <!-- Назва -->
                        <h5 class="card-title fw-bold my-course-title mb-3"
                            title="@course.Title">
                            @course.Title
                        </h5>

                        <!-- Короткий опис -->
                        <p class="card-text my-course-description mb-4">
                            @(string.IsNullOrWhiteSpace(course.Description)
                                ? "Опис курсу поки відсутній."
                                : course.Description)
                        </p>

                        <!-- Нижня частина -->
                        <div class="my-course-footer">

                            <div class="my-course-info mb-3">
                                <i class="bi bi-journal-text me-2"
                                   style="color: #3D5C4B;"></i>

                                Модулів: @(course.Modules?.Count ?? 0)
                            </div>

                            <a asp-controller="Course"
                               asp-action="Details"
                               asp-route-id="@course.Id"
                               class="btn my-course-button w-100">

                                <i class="bi bi-arrow-right-circle me-2"></i>
                                Переглянути курс

                            </a>

                        </div>

                    </div>
                </div>

            </div>
        }

    </div>
}
